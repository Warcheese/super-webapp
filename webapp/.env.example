# Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=192.168.178.39,localhost,127.0.0.1
SUPER_PORT=8088
# Direkter Pool-Pfad auf Unraid. Bei dir den tatsächlichen Poolnamen einsetzen.
SUPER_DATA_PATH=/mnt/appdata/super
